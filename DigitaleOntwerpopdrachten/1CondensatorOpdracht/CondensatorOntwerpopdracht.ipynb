    "# Index r=0 en z≈0\n",
    "idx_r0 = np.argmin(np.abs(r_for_E))\n",
    "idx_z0 = np.argmin(np.abs(z_for_E))\n",
    "\n",
    "# Elektrisch veldcomponent loodrecht op schijf (Ez)\n",
    "Ez_middle = Ez[idx_z0, idx_r0]\n",
    "\n",
    "# Oppervlaktelading in het centrum\n",
    "sigma_0 = epsilon0 * Ez_middle\n",
