    "# VRAAG 3 EN 4\n",
    "\n",
    "print(\" \")\n",
    "print(\"VRAAG 3 EN 4:\")\n",
    "print(\" \")\n",
    "\n",
    "# r-waarden tussen 0 en R\n",
    "r_plot = np.linspace(0, disk_radius, 500, endpoint=False)\n",
    "\n",
    "# Geleidende schijf\n",
    "sigma_conductor = Q / (2 * np.pi * disk_radius * np.sqrt(disk_radius**2 - r_plot**2))\n",
    "\n",
    "# Uniforme schijf\n",
    "sigma_uniform_plot = np.full_like(r_plot, sigma_uniform)\n",
    "\n",
    "# Plot\n",
    "plt.figure()\n",
    "plt.plot(r_plot, sigma_conductor, label=\"Geleidende schijf\")\n",
    "plt.plot(r_plot, sigma_uniform_plot, linestyle=\"--\", label=\"Uniform geladen schijf\")\n",
    "plt.xlim(0, disk_radius * 1.1)\n",
    "plt.xlabel(\"r (m)\")\n",
