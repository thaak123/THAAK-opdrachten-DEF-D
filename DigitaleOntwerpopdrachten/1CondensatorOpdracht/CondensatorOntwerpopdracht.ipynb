    "print(\"Totale lading op de geleidende schijf = Q =\", f\"{Q:.3e}\", \"C\")\n",
    "\n",
    "# VRAAG 2\n",
    "print(\" \")\n",
    "print(\"VRAAG 2:\")\n",
    "print(\" \")\n",
    "\n",
    "sigma_uniform = Q / (np.pi * disk_radius**2)\n",
    "\n",
    "print(\"Oppervlaktelading in het centrum:\")\n",
    "print(f\"Geleidende schijf σ(0)      = \", f\"{sigma_0:.3e}\", \" C/m²\")\n",
    "print(f\"Uniform geladen schijf σ_u  = \", f\"{sigma_uniform:.3e}\", \" C/m²\")\n",
    "\n",
    "ratio = sigma_0 / sigma_uniform\n",
    "print(f\"Verhouding σ(0) / σ_uniform = \", f\"{ratio:.3f}\")\n",
